@{
    ViewData["Title"] = "Đăng ký tài khoản";
}
<!--Nội dung đăng kí-->
<main>
    <div class="container-lg">
        <div class="form-container">
            <h2 id="form-title">Đăng ký</h2>

            <form id="dynamic-form" method="POST">
                <label>Họ và tên</label>
                <div>
                    <input class="display-ip"
                           type="text"
                           id="name"
                           placeholder="Họ và tên"
                           name="name"/>
                    <br>
                    <span id="no_name" class="error"></span>
                </div>
                <label>Số điện thoại</label>
                <div>
                    <input class="display-ip"
                           type="text"
                           id="numberphone"
                           placeholder="Số điện thoại"
                           name="numberphone"/>
                    <br>
                    <span id="no_numberphone" class="error"></span>
                </div>
                <label for="dob" class="label">Ngày sinh</label>
                <div>
                    <input type="date" id="dateofbirth" class="display-ip" name="dateofbirth">
                    <br>
                    <span id="no_date" class="error"></span>
                </div>
                <label>Tên đăng nhập</label>
                <div>
                    <input class="display-ip"
                           type="text"
                           id="username"
                           placeholder="Tên đăng nhập"
                           name="username"/>
                    <br>
                    <span id="no_username" class="error"></span>
                </div>
                <label>Mật khẩu</label>
                <div>
                    <input class="display-ip"
                           type="password"
                           id="password"
                           placeholder="Mật khẩu"
                           name="password"/>
                    <br>
                    <span id="no_pass" class="error"></span>
                </div>
                <label>Nhập lại mật khẩu</label>
                <div>
                    <input class="display-ip"
                           type="password"
                           id="re_pass"
                           placeholder="Nhập lại mật khẩu"
                           name="re_pass"/>
                    <br>
                    <span id="no_cfpass" class="error"></span>
                </div>
                <button id="register-btn" class="bt-submit" type="submit">Hoàn tất</button>
            </form>
        </div>
        <div class="Img-ads">
            <img src="/resource/image_container/themelogin.jpg"
                 alt="Plane ADS" />
        </div>
    </div>
</main>
<script src="/js/site.js"></script>


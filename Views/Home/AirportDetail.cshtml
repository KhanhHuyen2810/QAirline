@{
    ViewData["Title"] = "Thông tin sân bay";
}

<h1 class="airport-detail-title">Thông tin sân bay</h1>

<!-- Bảng để hiển thị thông tin sân bay -->
<table id="airportTable" class="table">
    <thead>
        <tr>
            <th>Tên sân bay</th>
            <th>Địa điểm</th>
            <th>Mã IATA</th>
            <th>Mã ICAO</th>
            <th>Loại sân bay</th>
        </tr>
    </thead>
    <tbody>
        <!-- Dữ liệu sân bay sẽ được hiển thị ở đây -->
    </tbody>
</table>

@section Scripts {
    <script src="/js/site.js"></script>
}
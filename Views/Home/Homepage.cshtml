@{
    ViewData["Title"] = "Enjoy your Flight";
}
<!-- Nội dung chính của trang chủ: đặt vé cơ bản, gợi ý điểm đến -->
<div class="container">
    <img class="theme" src="/resource/image_container/christmas_theme.png" alt="Christmas Theme">
    <div class="basic-booking">
        <div class="basic-booking-title">ĐẶT VÉ | TÌM CHUYẾN BAY</div>
        <div class="basic-booking-content">
            <div class="trip-type-selection">
                <label>
                    <input type="radio" name="trip-type" value="one-way" checked onclick="toggleContent()"> Một chiều
                </label>
                <label>
                    <input type="radio" name="trip-type" value="round-trip" onclick="toggleContent()"> Khứ hồi
                </label>
            </div>
            <hr>
            <!-- Nội dung một chiều -->
            <div id="one-way-content">
                <div class="location">
                    <div class="form-group">
                        <label for="start-point">Điểm đi:</label>
                        <input type="text" id="start-point" placeholder="Nhập điểm đi">
                    </div>
                    <div class="form-group">
                        <label for="end-point">Điểm đến:</label>
                        <input type="text" id="end-point" placeholder="Nhập điểm đến">
                    </div>
                </div>
                <div class="time">
                    <div class="form-group">
                        <label for="departure-date">Ngày đi:</label>
                        <input type="date" id="departure-date">
                    </div>
                </div>
            </div>

            <!-- Nội dung khứ hồi -->
            <div id="round-trip-content" class="hidden">
                <div class="location">
                    <div class="form-group">
                        <label for="start-point-round">Điểm đi:</label>
                        <input type="text" id="start-point-round" placeholder="Nhập điểm đi">
                    </div>
                    <div class="form-group">
                        <label for="end-point-round">Điểm đến:</label>
                        <input type="text" id="end-point-round" placeholder="Nhập điểm đến">
                    </div>
                </div>
                <div class="time">
                    <div class="form-group">
                        <label for="departure-date">Ngày đi:</label>
                        <input type="date" id="departure-date">
                    </div>
                    <div class="form-group">
                        <label for="return-date">Ngày về:</label>
                        <input type="date" id="return-date">
                    </div>
                </div>
            </div>
            <hr />
            <input type="button" name="flight-search" value="Tìm chuyến bay" id="flight-search-btn">
        </div>
    </div>
    <!-- Gợi ý điểm đến -->
    <div class="famous-destination">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-6 col-md-4 col-lg-4 mb-4">
                <div id="hanoi-card" class="card" style="width: 18rem;">
                    <img class="card-img-top" src="/resource/image_container/ha_noi.jpg" alt="Ha Noi">
                    <div class="card-body">
                        <h5 class="card-title">Hà Nội</h5>
                        <p class="card-text">Hà Nội, thủ đô ngàn năm văn hiến của Việt Nam, là sự kết hợp hài hòa giữa vẻ đẹp cổ kính với nhịp sống hiện đại, nơi có thể khám phá những con phố xưa cũ và thưởng thức ẩm thực đặc sắc.</p>
                        <a href="javascript:fetchCustomerData('/Home/BookingPage', '#customer-body');" class="btn btn-primary">Đặt vé ngay</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-4 mb-4">
                <div id="danang-card" class="card" style="width: 18rem;">
                    <img class="card-img-top" src="/resource/image_container/da_nang.png" alt="Da Nang">
                    <div class="card-body">
                        <h5 class="card-title">Đà Nẵng</h5>
                        <p class="card-text">Đà Nẵng là thành phố biển xinh đẹp của Việt Nam, nổi bật với bãi biển Mỹ Khê, cầu Rồng, và các di sản văn hóa như phố cổ Hội An và di tích Mỹ Sơn gần đó.</p>
                        <a href="javascript:fetchCustomerData('/Home/BookingPage', '#customer-body');" class="btn btn-primary">Đặt vé ngay</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-4 mb-4">
                <div id="hcmc-card" class="card" style="width: 18rem;">
                    <img class="card-img-top" src="/resource/image_container/hcmc.jpg" alt="Ho Chi Minh City">
                    <div class="card-body">
                        <h5 class="card-title">Thành phố Hồ Chí Minh</h5>
                        <p class="card-text">TP. Hồ Chí Minh là trung tâm kinh tế sôi động của Việt Nam, nổi bật với những công trình hiện đại, các di tích lịch sử như Dinh Độc Lập, và nền văn hóa đa dạng.</p>
                        <a href="javascript:fetchCustomerData('/Home/BookingPage', '#customer-body');" class="btn btn-primary">Đặt vé ngay</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-4 mb-4">
                <div id="china-card" class="card" style="width: 18rem;">
                    <img class="card-img-top" src="/resource/image_container/china.jpg" alt="Trung Quoc">
                    <div class="card-body">
                        <h5 class="card-title">Trung Quốc</h5>
                        <p class="card-text">Trung Quốc, với lịch sử lâu dài và nền văn hóa phong phú, là quốc gia rộng lớn sở hữu những danh lam thắng cảnh nổi tiếng như Vạn Lý Trường Thành, Cố Cung và thành phố hiện đại như Thượng Hải.</p>
                        <a href="javascript:fetchCustomerData('/Home/BookingPage', '#customer-body');" class="btn btn-primary">Đặt vé ngay</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-4 mb-4">
                <div id="japan-card" class="card" style="width: 18rem;">
                    <img class="card-img-top" src="/resource/image_container/japan.jpg" alt="Nhat Ban">
                    <div class="card-body">
                        <h5 class="card-title">Nhật Bản</h5>
                        <p class="card-text">Nhật Bản là quốc gia nổi bật với sự kết hợp giữa truyền thống lâu đời, như các đền chùa và lễ hội, cùng sự phát triển công nghệ hiện đại, tạo nên một nền văn hóa độc đáo và đa dạng.</p>
                        <a href="javascript:fetchCustomerData('/Home/BookingPage', '#customer-body');" class="btn btn-primary">Đặt vé ngay</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-4 mb-4">
                <div id="korea-card" class="card" style="width: 18rem;">
                    <img class="card-img-top" src="/resource/image_container/seoul.jpg" alt="Han Quoc">
                    <div class="card-body">
                        <h5 class="card-title">Hàn Quốc</h5>
                        <p class="card-text">Hàn Quốc là quốc gia nổi bật với sự pha trộn giữa truyền thống lâu đời, như cung điện Gyeongbokgung, và nền văn hóa hiện đại, đặc biệt là trong âm nhạc K-pop, điện ảnh và công nghệ tiên tiến.</p>
                        <a href="javascript:fetchCustomerData('/Home/BookingPage', '#customer-body');" class="btn btn-primary">Đặt vé ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

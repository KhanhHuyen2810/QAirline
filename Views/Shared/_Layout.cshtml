<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>QAirline | @ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=KoHo:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&family=Source+Code+Pro&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Header: search bar, login-signup, menu -->
    <header class="header">
        <img id="logo" src="/resource/image_header/logo.png" alt="Logo" onclick="home();">
        <div class="right_container">
            <div id="login">
                <img src="/resource/image_header/login.png" alt="Login">
                <a class="logInButton" href="javascript:void(0)">Đăng nhập</a> | <a class="logInButton" href="javascript:void(0)">Đăng ký</a>
            </div>
            <div id="service">
                <img src="/resource/image_header/service.png" alt="Support">
                <a href="">Hỗ trợ</a>
            </div>
            <div class="search">
                <input class="search-bar" type="text" placeholder="Tìm kiếm">
                <button class="search-btn">🔎</button>
            </div>
        </div>
        <div class="right-menu">
            <ul class="navbar">
                <li class="nav-item">
                    <a class="nav-link" href="#">TRANG CHỦ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">ĐẶT VÉ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">CHUYẾN BAY CỦA TÔI</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">TIN TỨC</a>
                </li>
                <li class="nav-item">
                    <a href="javascript:void(0)" id="viewAirportsButton" class="nav-link">SÂN BAY</a>
                </li>
            </ul>
        </div>
    </header>

        @RenderBody()

    <!-- Footer: contact methods -->
    <footer class="footer"></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
